    <worksheet name='ROAS Trend'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#000000' fontsize='14'><![CDATA[<[Parameters].[Parameter 1593245683654668]>]]></run>
            <run fontalignment='1' fontcolor='#000000' fontsize='14'> by month and platform</run>
            <run fontalignment='1'>Æ&#10;</run>
            <run fontalignment='1' fontcolor='#000000' fontsize='10'>Labels show the latest month in the selected range</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='global_ads_clean' name='federated.09d94ej0o3006d15qpwxc12npasb' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select KPI' datatype='string' name='[Parameter 1593245683654668]' param-domain-type='list' role='measure' type='nominal' value='&quot;ROAS&quot;'>
              <calculation class='tableau' formula='&quot;ROAS&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.09d94ej0o3006d15qpwxc12npasb'>
            <column caption='ROAS (calc)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1593245646925824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([revenue]) / SUM([ad_spend])' />
            </column>
            <column caption='CPA (calc)' datatype='real' default-format='n&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[Calculation_1593245648527361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ad_spend]) / SUM([conversions])' />
            </column>
            <column caption='CTR (calc)' datatype='real' default-format='p0.00%' name='[Calculation_1593245648662530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([clicks]) / SUM([impressions])' />
            </column>
            <column caption='CPC (calc)' datatype='real' default-format='n&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[Calculation_1593245648728067]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ad_spend]) / SUM([clicks])' />
            </column>
            <column caption='Conv Rate' datatype='real' default-format='p0.00%' name='[Calculation_1593245648801796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([conversions]) / SUM([clicks])' />
            </column>
            <column caption='Selected KPI' datatype='real' name='[Calculation_1593245684137997]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1593245683654668]&#13;&#10;   WHEN &quot;ROAS&quot; THEN [Calculation_1593245646925824]&#13;&#10;   WHEN &quot;CPA&quot; THEN [Calculation_1593245648527361]&#13;&#10;   WHEN &quot;CTR&quot; THEN [Calculation_1593245648662530]&#13;&#10;   WHEN &quot;CPC&quot; THEN [Calculation_1593245648728067]&#13;&#10;   WHEN &quot;Conv Rate&quot; THEN [Calculation_1593245648801796]&#13;&#10;   END' />
            </column>
            <column caption='Selected KPI Label' datatype='string' name='[Calculation_1593245684240398]' role='measure' type='nominal'>
              <calculation class='tableau' formula='CASE [Parameters].[Parameter 1593245683654668]&#13;&#10;WHEN &quot;ROAS&quot; THEN STR(ROUND([Calculation_1593245646925824], 2))&#13;&#10;WHEN &quot;CPA&quot; THEN &quot;$&quot; + STR(ROUND([Calculation_1593245648527361], 2))&#13;&#10;WHEN &quot;CPC&quot; THEN &quot;$&quot; + STR(ROUND([Calculation_1593245648728067], 2))&#13;&#10;WHEN &quot;CTR&quot; THEN STR(ROUND([Calculation_1593245648662530] * 100, 2)) + &quot;%&quot;&#13;&#10;WHEN &quot;Conv Rate&quot; THEN STR(ROUND([Calculation_1593245648801796] * 100, 2)) + &quot;%&quot;&#13;&#10;END' />
            </column>
            <column caption='Ad Spend' datatype='real' name='[ad_spend]' role='measure' type='quantitative' />
            <column caption='Clicks' datatype='integer' name='[clicks]' role='measure' type='quantitative' />
            <column caption='Conversions' datatype='integer' name='[conversions]' role='measure' type='quantitative' />
            <column caption='Impressions' datatype='integer' name='[impressions]' role='measure' type='quantitative' />
            <column caption='Month' datatype='date' name='[month]' role='dimension' type='ordinal' />
            <column-instance column='[platform]' derivation='None' name='[none:platform:nk]' pivot='key' type='nominal' />
            <column caption='Platform' datatype='string' name='[platform]' role='dimension' type='nominal' />
            <column caption='Revenue' datatype='real' name='[revenue]' role='measure' type='quantitative' />
            <column-instance column='[month]' derivation='Month-Trunc' name='[tmn:month:ok]' pivot='key' type='ordinal' />
