  <worksheets>
    <worksheet name='Budget Share'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Book'>Share of </run>
            <run fontalignment='1' fontcolor='#7d858f' fontname='Tableau Book'>ad spend</run>
            <run fontalignment='1' fontcolor='#000000' fontname='Tableau Book'> vs share of </run>
            <run fontalignment='1' fontcolor='#1f3a5f' fontname='Tableau Book'>revenue</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='global_ads_clean' name='federated.09d94ej0o3006d15qpwxc12npasb' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select KPI' datatype='string' name='[Parameter 1593245683654668]' param-domain-type='list' role='measure' type='nominal' value='&quot;ROAS&quot;'>
              <calculation class='tableau' formula='&quot;ROAS&quot;' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.09d94ej0o3006d15qpwxc12npasb'>
            <column datatype='real' name='[CPA]' role='measure' type='quantitative' />
            <column datatype='real' name='[CPC]' role='measure' type='quantitative' />
            <column datatype='real' name='[CTR]' role='measure' type='quantitative' />
            <column caption='Share of ad spend' datatype='real' name='[Calculation_1334311250866176]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ad_spend]) / TOTAL(SUM([ad_spend]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Share of revenue' datatype='real' name='[Calculation_1334311250948097]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([revenue]) / TOTAL(SUM([revenue]))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='Selected KPI (color)' datatype='real' name='[Calculation_1482195512283137]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Parameters].[Parameter 1593245683654668] = &quot;CPA&quot; OR [Parameters].[Parameter 1593245683654668] = &quot;CPC&quot;&#13;&#10;   THEN -[Calculation_1593245684137997]&#13;&#10;   ELSE [Calculation_1593245684137997]&#13;&#10;   END' />
            </column>
            <column caption='ROAS (calc)' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1593245646925824]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([revenue]) / SUM([ad_spend])' />
            </column>
            <column caption='CPA (calc)' datatype='real' default-format='n&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[Calculation_1593245648527361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ad_spend]) / SUM([conversions])' />
            </column>
            <column caption='CTR (calc)' datatype='real' default-format='p0.00%' name='[Calculation_1593245648662530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([clicks]) / SUM([impressions])' />
            </column>
            <column caption='CPC (calc)' datatype='real' default-format='n&quot;$&quot;#,##0.00;-&quot;$&quot;#,##0.00' name='[Calculation_1593245648728067]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([ad_spend]) / SUM([clicks])' />
            </column>
            <column caption='Conv Rate' datatype='real' default-format='p0.00%' name='[Calculation_1593245648801796]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([conversions]) / SUM([clicks])' />
            </column>
            <column caption='Best ROAS' datatype='real' default-format='n#,##0.00;-#,##0.00' name='[Calculation_1593245668732934]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='LOOKUP([Calculation_1593245646925824], FIRST())'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column aggregation='Attribute' caption='Overall ROAS' datatype='real' name='[Calculation_1593245680541707]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='{ EXCLUDE [platform] : SUM([revenue]) / SUM([ad_spend]) }' />
