                  </zone-style>
                </zone>
                <zone forceUpdate='true' h='12514' id='66' type-v2='text' w='50000' x='50000' y='87486'>
                  <formatted-text>
                    <run bold='true' fontsize='14'>Budget shift hypothesis</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#333333' fontsize='10'>Google Ads takes 57% of ad spend but returns 41% of revenue. TikTok Ads takes 24% of spend and returns 37%. Moving part of the Google budget to TikTok may lift total ROAS, if TikTok keeps its average return as spend grows. Test with a small shift first.</run>
                    <run>Æ&#10;</run>
                    <run fontcolor='#e6e6e6' fontsize='10'>Full period, all platforms.</run>
                  </formatted-text>
                  <zone-style>
                    <format attr='border-color' value='#000000' />
                    <format attr='border-style' value='none' />
                    <format attr='border-width' value='0' />
                    <format attr='margin' value='4' />
                    <format attr='padding' value='10' />
                  </zone-style>
                </zone>
              </zone>
            </zone>
          </zone>
        </zone>
      </zones>
